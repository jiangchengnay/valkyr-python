.{
    .name = .valkyr_core,
    .version = "0.1.0",
    .fingerprint = 0x3c1a7e9d4b2f8056,
    .minimum_zig_version = "0.14.1",
    .dependencies = .{
        // The Valkyr engine, consumed as a Zig package. Its build.zig
        // exposes the `valkyr_gpu` module (see projects/valkyr-engine/build.zig,
        // `b.addModule("valkyr_gpu", ...)`), which is what src/bindings.zig imports.
        .valkyr = .{ .path = "../valkyr-engine" },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
    },
}
